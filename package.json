{
  "name": "blockworld-field-edition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e",
    "format": "prettier --write src tests e2e *.json *.ts *.html",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "vite build --mode benchmark --outDir .benchmark && node tools/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.182.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  }
}
